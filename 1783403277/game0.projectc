[project]
title = Piece of Cake
version = 21.12
publisher = 
developer = 
write_log = 0
write_log_file = 0
minimum_log_level = 1
compress_archive = 1
custom_resources = assets/settings,assets/locale,assets/messages.proto,assets/imgui_res
bundle_resources = /res, hg/resources
editor_build = 0
revision = v21.12.1
bundle_identifier = com.happygames.mergecafe
title_as_file_name = PieceofCake

[display]
width = 1136
height = 640
high_dpi = 1
samples = 0
fullscreen = 0
display_profiles = /render/webmerge.display_profilesc
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1
vsync = 1
variable_dt = 0
display_device_info = 0

[render]
clear_color_red = 0
clear_color_green = 0
clear_color_blue = 0
clear_color_alpha = 1

[physics]
